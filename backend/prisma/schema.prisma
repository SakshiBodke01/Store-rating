// Store Rating Platform - Prisma Schema (MySQL Database)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("USER") @db.VarChar(50)
  address      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  ownedStores Store[]  @relation("StoreOwner")
  ratings     Rating[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Store {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(191)
  email       String?  @db.VarChar(191)
  address     String   @db.Text
  description String?  @db.Text
  category    String?  @default("Retail & Services") @db.VarChar(100)
  phone       String?  @db.VarChar(50)
  isVerified  Boolean  @default(true) @map("is_verified")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner   User     @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ratings Rating[]

  @@index([name])
  @@index([ownerId])
  @@index([category])
  @@map("stores")
}

model Rating {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?  @db.Text
  userId    String   @map("user_id")
  storeId   String   @map("store_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Enforce unique rating per user/store pair
  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@index([rating])
  @@map("ratings")
}
