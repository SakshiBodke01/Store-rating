{
  "name": "store-rating-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST API for Store Rating Platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npx nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "node --test src/__tests__/**/*.test.js",
    "lint": "npx eslint src/**/*.js",
    "lint:fix": "npx eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "express": "^4.19.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.3.3",
    "prisma": "^6.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
